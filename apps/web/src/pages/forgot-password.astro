---
import AuthLayout from '../layouts/AuthLayout.astro';

const API_URL = import.meta.env.API_URL ?? 'http://127.0.0.1:3000';
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
let sent = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').toLowerCase();
  const turnstileToken = String(form.get('cf-turnstile-response') ?? '') || undefined;
  if (!email.endsWith('@trigunabhakti.or.id')) {
    error = 'Email wajib menggunakan domain @trigunabhakti.or.id';
  } else {
    const res = await fetch(`${API_URL}/auth/forgot-password`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ email, turnstileToken }),
    }).catch(() => null);
    if (res && res.status === 429) {
      error = 'Terlalu banyak permintaan. Tunggu satu menit.';
    } else {
      sent = true; // respons selalu sama — anti-enumeration selaras API
    }
  }
}
---

<AuthLayout title="Lupa Password">
  <h1 class="text-3xl font-bold text-neutral-900">Lupa password</h1>
  <p class="mt-2 text-sm text-neutral-500">Masukkan email untuk menerima instruksi reset.</p>

  {sent ? (
    <div class="mt-8 rounded-lg border border-green-200 bg-green-50 px-4 py-4 text-sm text-green-800">
      Jika email terdaftar, instruksi reset telah dikirim. Silakan cek inbox.
    </div>
  ) : (
    <>
      {error && <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-700">{error}</div>}
      <form method="post" class="mt-8 space-y-5">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Email</span>
          <input
            type="email"
            name="email"
            required
            placeholder="nama@trigunabhakti.or.id"
            pattern=".+@trigunabhakti\.or\.id"
            title="Gunakan email @trigunabhakti.or.id"
            class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          />
        </label>
        {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>}
        <button
          type="submit"
          class="w-full rounded-full bg-brand-600 py-3 text-sm font-semibold text-white transition hover:bg-brand-700 focus:ring-4 focus:ring-brand-200"
        >
          Kirim
        </button>
      </form>
      {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    </>
  )}

  <p class="mt-8 text-center text-sm text-neutral-500">
    Kembali ke <a href="/login" class="font-semibold text-brand-600 hover:text-brand-700">halaman masuk</a>
  </p>
</AuthLayout>
