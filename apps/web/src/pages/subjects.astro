---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { api, ApiError, getMe, resolveActiveUnit } from '../lib/api';

const me = await getMe(Astro.cookies);
if (!me) return Astro.redirect('/login');
const activeUnitId = resolveActiveUnit(Astro.cookies, me);
if (!activeUnitId) return Astro.redirect('/login');

interface Subject { id: string; code: string; name: string }

let formError: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    await api(Astro.cookies, '/academic/subjects', {
      method: 'POST',
      unitId: activeUnitId,
      body: JSON.stringify({
        code: String(form.get('code') ?? '').toUpperCase(),
        name: String(form.get('name') ?? ''),
      }),
    });
    return Astro.redirect('/subjects');
  } catch (e) {
    formError = e instanceof ApiError && e.status === 409 ? 'Kode mapel sudah ada.' : 'Data tidak valid.';
  }
}

const subjects = await api<Subject[]>(Astro.cookies, '/academic/subjects', { unitId: activeUnitId }).catch(() => [] as Subject[]);
---

<DashboardLayout title="Mata Pelajaran" me={me} activeUnitId={activeUnitId} active="subjects">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-2xl font-bold text-neutral-900">Mata Pelajaran</h2>
      <p class="mt-1 text-sm text-neutral-500">Kode mapel dipakai rate honor HRIS — jaga tetap stabil.</p>
    </div>
    <button type="button" onclick="document.getElementById('add-subject').showModal()" class="rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">+ Tambah</button>
  </div>

  {formError && <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-700">{formError}</div>}

  <div class="mt-6 rounded-xl border border-neutral-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-neutral-200 text-xs font-semibold tracking-wide text-neutral-400 uppercase">
          <th class="px-5 py-3">Kode</th>
          <th class="px-5 py-3">Nama</th>
        </tr>
      </thead>
      <tbody>
        {subjects.length === 0 && <tr><td colspan="2" class="px-5 py-10 text-center text-neutral-400">Belum ada mapel.</td></tr>}
        {subjects.map((s) => (
          <tr class="border-b border-neutral-100 hover:bg-neutral-50">
            <td class="px-5 py-3.5"><span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">{s.code}</span></td>
            <td class="px-5 py-3.5 font-semibold text-neutral-900">{s.name}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <dialog id="add-subject" class="m-auto w-full max-w-md rounded-2xl p-0 backdrop:bg-black/40">
    <form method="post" class="p-6">
      <h3 class="text-lg font-bold text-neutral-900">Tambah Mapel</h3>
      <div class="mt-5 space-y-4">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Kode</span>
          <input name="code" required maxlength="16" placeholder="MTK" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm uppercase outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Nama</span>
          <input name="name" required maxlength="128" placeholder="Matematika" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        </label>
      </div>
      <div class="mt-6 flex justify-end gap-3">
        <button type="button" onclick="this.closest('dialog').close()" class="rounded-full border border-neutral-300 px-5 py-2 text-sm font-semibold text-neutral-600">Batal</button>
        <button type="submit" class="rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white hover:bg-brand-700">Simpan</button>
      </div>
    </form>
  </dialog>
</DashboardLayout>
