---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { api, ApiError, getMe, resolveActiveUnit } from '../lib/api';

const me = await getMe(Astro.cookies);
if (!me) return Astro.redirect('/login');
const activeUnitId = resolveActiveUnit(Astro.cookies, me);
if (!activeUnitId) return Astro.redirect('/login');

interface Year { id: string; label: string; startsOn: string; endsOn: string; isActive: boolean }

let formError: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? 'create');
  try {
    if (action === 'activate') {
      await api(Astro.cookies, `/academic/years/${String(form.get('id'))}/activate`, {
        method: 'POST',
        unitId: activeUnitId,
      });
    } else {
      await api(Astro.cookies, '/academic/years', {
        method: 'POST',
        unitId: activeUnitId,
        body: JSON.stringify({
          label: String(form.get('label') ?? ''),
          startsOn: String(form.get('startsOn') ?? ''),
          endsOn: String(form.get('endsOn') ?? ''),
        }),
      });
    }
    return Astro.redirect('/years');
  } catch (e) {
    formError =
      e instanceof ApiError && e.status === 409
        ? 'Tahun ajaran dengan label itu sudah ada.'
        : 'Data tidak valid (format label: 2026/2027).';
  }
}

const years = await api<Year[]>(Astro.cookies, '/academic/years', { unitId: activeUnitId }).catch(() => [] as Year[]);
---

<DashboardLayout title="Tahun Ajaran" me={me} activeUnitId={activeUnitId} active="years">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-2xl font-bold text-neutral-900">Tahun Ajaran</h2>
      <p class="mt-1 text-sm text-neutral-500">Satu tahun ajaran aktif per unit.</p>
    </div>
    <button type="button" onclick="document.getElementById('add-year').showModal()" class="rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">+ Tambah</button>
  </div>

  {formError && <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-700">{formError}</div>}

  <div class="mt-6 rounded-xl border border-neutral-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-neutral-200 text-xs font-semibold tracking-wide text-neutral-400 uppercase">
          <th class="px-5 py-3">Label</th>
          <th class="px-5 py-3">Mulai</th>
          <th class="px-5 py-3">Selesai</th>
          <th class="px-5 py-3">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {years.length === 0 && <tr><td colspan="5" class="px-5 py-10 text-center text-neutral-400">Belum ada tahun ajaran.</td></tr>}
        {years.map((y) => (
          <tr class="border-b border-neutral-100 hover:bg-neutral-50">
            <td class="px-5 py-3.5 font-semibold text-neutral-900">{y.label}</td>
            <td class="px-5 py-3.5 text-neutral-600">{y.startsOn.slice(0, 10)}</td>
            <td class="px-5 py-3.5 text-neutral-600">{y.endsOn.slice(0, 10)}</td>
            <td class="px-5 py-3.5">
              {y.isActive
                ? <span class="rounded-full bg-green-50 px-2.5 py-1 text-xs font-semibold text-green-700">Aktif</span>
                : <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-semibold text-neutral-500">Nonaktif</span>}
            </td>
            <td class="px-5 py-3.5 text-right">
              {!y.isActive && (
                <form method="post" class="inline">
                  <input type="hidden" name="_action" value="activate" />
                  <input type="hidden" name="id" value={y.id} />
                  <button class="text-sm font-semibold text-brand-600 hover:text-brand-700">Aktifkan</button>
                </form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <dialog id="add-year" class="m-auto w-full max-w-md rounded-2xl p-0 backdrop:bg-black/40">
    <form method="post" class="p-6">
      <h3 class="text-lg font-bold text-neutral-900">Tambah Tahun Ajaran</h3>
      <div class="mt-5 space-y-4">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Label</span>
          <input name="label" required placeholder="2026/2027" pattern="\d{4}/\d{4}" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Tanggal Mulai</span>
          <input type="date" name="startsOn" required class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-neutral-700">Tanggal Selesai</span>
          <input type="date" name="endsOn" required class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500" />
        </label>
      </div>
      <div class="mt-6 flex justify-end gap-3">
        <button type="button" onclick="this.closest('dialog').close()" class="rounded-full border border-neutral-300 px-5 py-2 text-sm font-semibold text-neutral-600">Batal</button>
        <button type="submit" class="rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white hover:bg-brand-700">Simpan</button>
      </div>
    </form>
  </dialog>
</DashboardLayout>
