---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { api, ApiError, getMe, resolveActiveUnit } from '../lib/api';

const me = await getMe(Astro.cookies);
if (!me) return Astro.redirect('/login');
const activeUnitId = resolveActiveUnit(Astro.cookies, me);
if (!activeUnitId) return Astro.redirect('/login');

let setup: { otpauthUrl: string; secret: string } | null = null;
let message: string | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  try {
    if (action === 'setup') {
      setup = await api<{ otpauthUrl: string; secret: string }>(Astro.cookies, '/auth/totp/setup', { method: 'POST' });
    } else if (action === 'enable') {
      await api(Astro.cookies, '/auth/totp/enable', {
        method: 'POST',
        body: JSON.stringify({ code: String(form.get('code') ?? '') }),
      });
      message = 'MFA aktif. Mulai sekarang login membutuhkan kode autentikator.';
    }
  } catch (e) {
    error = e instanceof ApiError && e.status === 400 ? 'Kode salah atau setup belum dijalankan.' : 'Terjadi kesalahan.';
    if (action === 'enable') {
      // Tampilkan ulang QR supaya user bisa coba lagi tanpa restart alur.
      setup = null;
    }
  }
}

// QR digambar client-side dari otpauth URL via api.qrserver (tanpa dependensi).
// ponytail: ganti generator QR lokal (lib qrcode) kalau kebijakan melarang URL eksternal.
const qrSrc = setup
  ? `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(setup.otpauthUrl)}`
  : null;
---

<DashboardLayout title="Keamanan Akun" me={me} activeUnitId={activeUnitId} active="dashboard">
  <h2 class="text-2xl font-bold text-neutral-900">Keamanan Akun</h2>
  <p class="mt-1 text-sm text-neutral-500">Autentikasi dua langkah (TOTP) — wajib untuk Yayasan Admin & Bendahara.</p>

  {message && <div class="mt-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{message}</div>}
  {error && <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-700">{error}</div>}

  <div class="mt-6 max-w-xl rounded-xl border border-neutral-200 bg-white p-6">
    {me.mfaEnabled || message ? (
      <div class="flex items-center gap-3">
        <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">Aktif</span>
        <p class="text-sm text-neutral-600">MFA sudah terpasang di akun ini.</p>
      </div>
    ) : setup ? (
      <>
        <h3 class="font-semibold text-neutral-900">1. Scan QR di aplikasi autentikator</h3>
        <p class="mt-1 text-sm text-neutral-500">Google Authenticator, Aegis, atau 1Password.</p>
        <img src={qrSrc} alt="QR TOTP" width="220" height="220" class="mt-4 rounded-lg border border-neutral-200" />
        <p class="mt-3 text-xs text-neutral-400">Tidak bisa scan? Masukkan manual: <code class="rounded bg-neutral-100 px-1.5 py-0.5 font-mono text-neutral-700">{setup.secret}</code></p>
        <h3 class="mt-6 font-semibold text-neutral-900">2. Masukkan kode 6 digit</h3>
        <form method="post" class="mt-3 flex gap-3">
          <input type="hidden" name="_action" value="enable" />
          <input name="code" required pattern="\d{6}" maxlength="6" inputmode="numeric" placeholder="123456" class="w-40 rounded-lg border border-neutral-300 px-4 py-2.5 text-center text-lg font-semibold tracking-[0.3em] outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
          <button class="rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Aktifkan</button>
        </form>
      </>
    ) : (
      <form method="post">
        <input type="hidden" name="_action" value="setup" />
        <p class="text-sm text-neutral-600">MFA belum aktif. Aktifkan untuk melindungi akun dari pengambilalihan — terutama akun yang menyentuh Ledger dan payroll.</p>
        <button class="mt-4 rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Mulai Setup MFA</button>
      </form>
    )}
  </div>
</DashboardLayout>
