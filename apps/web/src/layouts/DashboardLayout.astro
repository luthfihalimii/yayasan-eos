---
// Layout dashboard (desain ref: sidebar kiri, breadcrumb atas, konten kanan).
import '../styles/global.css';
import type { Me } from '../lib/api';

interface Props {
  title: string;
  me: Me;
  activeUnitId: string;
  active: 'dashboard' | 'students' | 'classes' | 'years' | 'subjects';
}
const { title, me, activeUnitId, active } = Astro.props;
const activeUnit = me.units.find((u) => u.id === activeUnitId);

const nav = [
  { key: 'dashboard', href: '/', label: 'Dashboard' },
  { key: 'students', href: '/students', label: 'Siswa' },
  { key: 'classes', href: '/classes', label: 'Kelas' },
  { key: 'years', href: '/years', label: 'Tahun Ajaran' },
  { key: 'subjects', href: '/subjects', label: 'Mata Pelajaran' },
] as const;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Yayasan EOS</title>
  </head>
  <body class="min-h-screen bg-neutral-100">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="flex w-60 flex-col border-r border-neutral-200 bg-white">
        <div class="flex items-center gap-2.5 px-5 py-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white">TB</div>
          <span class="text-base font-semibold text-brand-700">Yayasan EOS</span>
        </div>

        <nav class="flex-1 space-y-1 px-3 py-2">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium transition',
                active === item.key
                  ? 'bg-brand-50 text-brand-700'
                  : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="border-t border-neutral-200 p-4">
          <p class="truncate text-sm font-semibold text-neutral-800">{me.email}</p>
          <p class="text-xs text-neutral-400">{me.role}</p>
          <a href="/security" class="mt-2 block text-xs font-semibold text-brand-600 hover:text-brand-700">
            Keamanan akun {me.mfaEnabled ? '· MFA ✓' : '· MFA belum aktif'}
          </a>
          <form method="post" action="/logout" class="mt-3">
            <button class="w-full rounded-lg border border-neutral-200 py-2 text-xs font-semibold text-neutral-600 transition hover:border-brand-300 hover:text-brand-700">
              Keluar
            </button>
          </form>
        </div>
      </aside>

      <!-- Konten -->
      <div class="flex flex-1 flex-col">
        <header class="flex items-center justify-between border-b border-neutral-200 bg-white px-8 py-4">
          <h1 class="text-sm font-medium text-neutral-400">{title}</h1>
          {me.units.length > 1 && (
            <form method="post" action="/switch-unit">
              <select
                name="unitId"
                onchange="this.form.submit()"
                class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 outline-none focus:border-brand-500"
              >
                {me.units.map((u) => (
                  <option value={u.id} selected={u.id === activeUnitId}>{u.name}</option>
                ))}
              </select>
            </form>
          )}
          {me.units.length === 1 && activeUnit && (
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{activeUnit.name}</span>
          )}
        </header>

        <main class="flex-1 p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
